# Ignore everything by default
*

# Allow app source code
!app/
!app/src/
!app/src/main/
!app/src/main/aidl/
!app/src/main/aidl/**
!app/src/main/java/
!app/src/main/java/**
!app/src/main/res/
!app/src/main/res/**
!app/src/main/AndroidManifest.xml
!app/build.gradle.kts

# Allow test code
!app/src/test/
!app/src/test/java/
!app/src/test/java/**
!app/src/androidTest/
!app/src/androidTest/java/
!app/src/androidTest/java/**

# Allow documentation
!docs/
!docs/**
!README.md
!LICENSE

# Allow GitHub Actions
!.github/
!.github/**

# Ignore tools directory (qwen-eyes, etc.)
tools/

# Allow root project files
!.gitignore
!settings.gradle.kts
!build.gradle.kts
!gradle.properties
!gradle/
!gradle/**
!gradlew
!gradlew.bat

# Still ignore build outputs
app/build/
build/
.gradle/
*.iml
.idea/
.DS_Store
local.properties
.kotlin/
*.bak*
