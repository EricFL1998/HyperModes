# Ignore everything by default
*

# Allow app source code
!app/
!app/src/
!app/src/main/
!app/src/main/aidl/
!app/src/main/aidl/**
!app/src/main/java/
!app/src/main/java/**
!app/src/main/res/
!app/src/main/res/**
!app/src/main/AndroidManifest.xml
!app/build.gradle.kts
!app/proguard-rules.pro

# Allow test code
!app/src/test/
!app/src/test/java/
!app/src/test/java/**
!app/src/androidTest/
!app/src/androidTest/java/
!app/src/androidTest/java/**

# Allow documentation
!docs/
!docs/**
!README.md
!COMPLEX_TRIGGER_2.0_COMPLETED.md
!UI_FLOW.md
!INTEGRATION_EXAMPLE.kt
!QUICKSTART_V2.md
!README_TRIGGER_V2.md
!LICENSE

# Allow GitHub Actions
!.github/
!.github/**

# Allow root project files
!.gitignore
!settings.gradle.kts
!build.gradle.kts
!gradle.properties
!gradle/
!gradle/**
!gradlew
!gradlew.bat

# Still ignore build outputs
app/build/
build/
.gradle/
*.iml
.idea/
.DS_Store
local.properties
.kotlin/
*.bak*
