<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:set_alarm_number_picker="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dialog_holder"
    android:background="@drawable/drop_down_popup_window_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/drop_down_popup_window_height">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/modify_alarm_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="@dimen/drop_down_popup_window_title">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/modify_alarm_title_text_color"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/drop_down_popup_window_title_margin_top"
            android:text="@string/modify_alarm"
            android:singleLine="true"
            android:fontFamily="mipro-medium"
            android:layout_marginHorizontal="@dimen/drop_down_popup_window_title_margin_start"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/modify_alarm_title_desc_text_color"
            android:id="@+id/alarm_in_future_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6小时20分后闹钟将响起"
            android:singleLine="true"
            android:fontFamily="mipro-medium"/>
    </LinearLayout>
    <com.android.deskclock.widget.TimePicker
        android:id="@+id/time_picker"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_number_picker_height"
        android:layout_marginTop="@dimen/dialog_number_picker_margin_top"
        android:layout_marginBottom="@dimen/dialog_number_picker_margin_bottom"
        set_alarm_number_picker:layout="@layout/time_picker"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_button_height"
        android:layout_marginBottom="@dimen/dialog_button_margin_bottom">
        <Button
            android:gravity="center"
            android:id="@+id/alarm_more_setting"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_button_height"
            android:text="@string/alarm_clock_more_setting"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dialog_buttom_margin_start"
            android:layout_marginEnd="@dimen/dialog_buttom_margin_center"/>
        <Button
            android:gravity="center"
            android:id="@+id/set_alarm_done"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_button_height"
            android:text="@string/set_alarm_done"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dialog_buttom_margin_center"
            android:layout_marginEnd="@dimen/dialog_buttom_margin_start"
            style="@style/Widget.Button.Primary"/>
    </LinearLayout>
</LinearLayout>
