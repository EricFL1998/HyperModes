<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ringtone_item"
    android:padding="@dimen/ringtone_picker_item_border_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.smooth.SmoothFrameLayout2
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:radius="@dimen/ringtone_picker_item_card_radius"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:miuix_strokeWidth="0dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <VideoView
                android:id="@+id/video"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"/>
            <ImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/ringtone_picker_item_title_size"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:id="@+id/image_ringtone_all"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/ringtone_picker_item_title_max_width"
                android:text="@string/ringtone_all"
                android:maxLines="1"
                android:drawableTop="@drawable/ic_all_ringtone"
                android:drawablePadding="@dimen/ringtone_picker_item_padding_drawable"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="@dimen/ringtone_picker_item_title_size"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:id="@+id/title"
                android:paddingRight="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ringtone_picker_item_title_margin_bottom"
                android:maxLines="2"
                android:layout_alignParentBottom="true"
                android:paddingStart="@dimen/ringtone_picker_item_title_padding_start"/>
            <com.android.deskclock.view.PickerPlayView
                android:id="@+id/play"
                android:visibility="gone"
                android:layout_width="@dimen/ringtone_picker_item_play_width"
                android:layout_height="@dimen/ringtone_picker_item_play_width"
                android:layout_marginTop="@dimen/ringtone_picker_item_play_margin"
                android:layout_marginEnd="@dimen/ringtone_picker_item_play_margin"
                android:layout_toStartOf="@+id/title"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="@dimen/ringtone_picker_item_flag_size"
                android:textColor="@android:color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/more"
                android:background="@drawable/shape_more_bg"
                android:paddingTop="@dimen/ringtone_picker_item_flag_padding_top"
                android:paddingBottom="@dimen/ringtone_picker_item_flag_padding_bottom"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ringtone_picker_item_flag_margin_top"
                android:text="@string/ringtone_all"
                android:singleLine="true"
                android:importantForAccessibility="no"
                android:paddingStart="@dimen/ringtone_picker_item_flag_padding_start"
                android:paddingEnd="@dimen/ringtone_picker_item_flag_padding_end"
                android:layout_marginStart="@dimen/ringtone_picker_item_flag_margin_end"
                android:layout_marginEnd="@dimen/ringtone_picker_item_flag_margin_end"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </miuix.smooth.SmoothFrameLayout2>
</LinearLayout>
