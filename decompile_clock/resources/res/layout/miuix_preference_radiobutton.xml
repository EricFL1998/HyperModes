<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:background="?attr/radioPreferenceItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatRadioButton
        android:gravity="center_vertical"
        android:id="@android:id/checkbox"
        android:focusable="false"
        android:clickable="false"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:button="?attr/preferenceChoiceIndicatorSingle"
        android:layout_marginEnd="@dimen/miuix_preference_item_icon_margin_end"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/preference_icon_minWidth">
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@android:id/icon"
            android:scaleType="center"
            android:adjustViewBounds="true"
            style="@style/Widget.PreferenceIcon"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/Widget.PreferenceItem.Radio">
        <androidx.appcompat.widget.AppCompatCheckedTextView
            android:textAppearance="@style/Miuix.AppCompat.TextAppearance.PreferenceList.Checkable"
            android:ellipsize="end"
            android:id="@android:id/title"
            android:fadingEdge="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"/>
        <androidx.appcompat.widget.AppCompatCheckedTextView
            android:textAppearance="@style/Miuix.AppCompat.TextAppearance.List.Secondary.Preference.Checkable"
            android:id="@android:id/summary"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miuix_preference_summary_margin_top"
            android:layout_below="@android:id/title"
            android:textAlignment="viewStart"
            android:layout_alignStart="@android:id/title"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="@dimen/miuix_preference_widget_layout_max_width"
        android:minWidth="@dimen/miuix_preference_widget_width"/>
</LinearLayout>
