<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bedtime_manage_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <miuix.springback.view.SpringBackLayout
        android:id="@+id/bedtime_scroll_view"
        android:paddingBottom="@dimen/bedtime_alarm_scroll_view_bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scrollOrientation="vertical"
        app:scrollableView="@+id/scroll_view">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.miui.support.cardview.CardView
                android:id="@+id/sleep_no_disturbance_card_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/bedtime_setting_time_picker_margin_top"
                app:cardBackgroundColor="@color/bedtime_card_view_bg_color"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.android.deskclock.view.pref.AlarmCheckboxLayout
                        android:id="@+id/get_up_alert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:title="@string/wake_up_alert"
                        android:key="key_wake_up_alert"
                        android:summary="@string/wake_up_alert_desc"
                        android:defaultValue="true"/>
                    <View
                        android:layout_marginStart="@dimen/bedtime_single_line_margin_start"
                        android:layout_marginEnd="@dimen/bedtime_single_line_margin_start"
                        style="@style/BedtimeManagerSingleLine"/>
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:id="@+id/bedtime_display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            android:id="@+id/sleep_time"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/bedtime_alarm_start"
                            android:layout_alignParentStart="true"
                            layout="@layout/bedtime_display"/>
                        <View
                            android:background="@color/bedtime_setting_split_line_color"
                            android:layout_width="@dimen/bedtime_setting_split_line_width"
                            android:layout_height="@dimen/bedtime_setting_split_line_height"
                            android:layout_marginTop="@dimen/bedtime_setting_split_line_margin_top"
                            android:layout_centerHorizontal="true"/>
                        <include
                            android:id="@+id/get_up_time"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="@dimen/bedtime_alarm_start"
                            android:layout_alignParentEnd="true"
                            layout="@layout/bedtime_display"/>
                    </RelativeLayout>
                </LinearLayout>
            </com.miui.support.cardview.CardView>
        </androidx.core.widget.NestedScrollView>
    </miuix.springback.view.SpringBackLayout>
    <Button
        android:textStyle="normal"
        android:id="@+id/look_sleep_data"
        android:background="@drawable/look_sleep_data_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bedtime_alarm_btn_height"
        android:layout_marginBottom="@dimen/bedtime_alarm_btn_margin_bottom"
        android:text="@string/look_sleep_data"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/bedtime_alarm_btn_margin_start"
        android:layout_marginEnd="@dimen/bedtime_alarm_btn_margin_start"/>
</RelativeLayout>
