<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/set_alarm_ringtone_item_bg_margin"
        app:cardCornerRadius="@dimen/set_alarm_ringtone_picker_card_radius"
        app:cardElevation="0dp">
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/item_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/set_alarm_ringtone_icon_margin_top"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/set_alarm_ringtone_info_text_size"
                android:textColor="@color/set_alarm_ringtone_info_text_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/set_alarm_ringtone_info_margin_top"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/set_alarm_ringtone_info_margin_start"
                android:layout_marginEnd="3dp"/>
            <ImageView
                android:id="@+id/indicator"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/indicator_margin_top"
                android:src="@drawable/set_alarm_system_ringtone_indicator_icon"
                android:layout_below="@+id/info"
                android:layout_centerHorizontal="true"/>
            <com.android.deskclock.view.PlayView
                android:id="@+id/play"
                android:visibility="gone"
                android:layout_width="@dimen/set_alarm_ringtone_item_play_width"
                android:layout_height="@dimen/set_alarm_ringtone_item_play_height"
                android:layout_marginTop="@dimen/set_alarm_ringtone_item_icon_margin_top"
                android:layout_marginEnd="@dimen/set_alarm_ringtone_item_icon_margin_end"
                android:layout_alignParentEnd="true"/>
            <ImageView
                android:id="@+id/loading"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/set_alarm_ringtone_item_icon_margin_top"
                android:src="@drawable/rotate_loading"
                android:layout_marginEnd="@dimen/set_alarm_ringtone_item_icon_margin_end"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
