<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingLeft="@dimen/timezone_search_timezone_padding_left"
    android:paddingTop="@dimen/miuix_preference_item_padding_top"
    android:paddingRight="@dimen/timezone_search_timezone_padding_left"
    android:paddingBottom="@dimen/miuix_preference_item_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/miuix_preference_normal_text_size"
        android:textColor="@color/primary_text_color_dark"
        android:ellipsize="end"
        android:id="@+id/timezone_name"
        android:fadingEdge="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:fontFamily="@string/miuix_font_style_misans_medium_font_family"
        android:textAlignment="viewStart"
        android:layout_marginEnd="@dimen/timezone_search_name_margin_end"/>
    <TextView
        android:textSize="@dimen/miuix_preference_secondary_text_size"
        android:textColor="@color/timezone_search_bs_item_text_color"
        android:id="@+id/country_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/miuix_preference_summary_margin_top"
        android:maxWidth="@dimen/timezone_search_country_info_max_width"
        android:maxLines="2"
        android:layout_below="@+id/timezone_name"
        android:fontFamily="@string/miuix_font_style_misans_regular_font_family"
        android:textAlignment="viewStart"
        android:layout_alignStart="@+id/timezone_name"/>
    <TextView
        android:textSize="@dimen/miuix_preference_secondary_text_size"
        android:textColor="@color/timezone_search_bs_item_text_color"
        android:id="@+id/timezone_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/miuix_preference_summary_margin_top"
        android:layout_below="@+id/timezone_name"
        android:fontFamily="@string/miuix_font_style_misans_regular_font_family"
        android:layout_marginEnd="@dimen/timezone_search_timezone_info_margin_end"
        android:layout_toEndOf="@+id/country_info"/>
</RelativeLayout>
