<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/clock_information_text_size"
        android:textColor="@color/clock_information_text_color"
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/clock_information_text_top"
        android:layout_marginBottom="@dimen/clock_information_text_bottom"
        android:layout_alignParentTop="true"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/clock_information_image_top"
        android:layout_marginBottom="@dimen/clock_information_text_bottom"
        android:src="@drawable/clock_information_iv"
        android:layout_toRightOf="@android:id/title"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/clock_information_image_start"/>
</RelativeLayout>
