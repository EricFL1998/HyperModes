<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:FocusedByDefault="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/background_dialog"
        android:background="@color/alarm_edit_dialog_bg_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <include
        android:id="@+id/time_dialog"
        android:focusable="true"
        android:focusableInTouchMode="true"
        FocusedByDefault:focusedByDefault="true"
        layout="@layout/popup_window_bedtime_alarm_clock"/>
</RelativeLayout>
