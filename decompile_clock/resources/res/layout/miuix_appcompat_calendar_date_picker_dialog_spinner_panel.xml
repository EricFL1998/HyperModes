<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/spinnerPanel"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:paddingEnd="0dp"
    style="@style/CalendarDatePickerDialog.Panel">
    <TextView
        android:id="@+id/spinnerDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/CalendarDatePickerDialog.Text"/>
    <miuix.appcompat.widget.Spinner
        android:id="@+id/spinner"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        style="@style/CalendarDatePickerDialog.Widget"/>
</FrameLayout>
