<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="start"
    android:layout_gravity="center_horizontal"
    android:id="@+id/week_day_item"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="55dp"
    android:paddingStart="@dimen/alarm_time_layout_padding_left"
    android:paddingEnd="@dimen/alarm_time_layout_padding_left"
    style="@style/DeskClockListItemDoubleLineStyle">
    <TextView
        android:textSize="@dimen/alarm_repeat_text_size"
        android:textStyle="normal"
        android:textColor="@color/alarm_repeat_text_normal_color"
        android:id="@+id/weekday_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"/>
    <CheckBox
        android:id="@android:id/checkbox"
        android:visibility="visible"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/timezone_item_checkbox_margin_end"
        android:layout_alignParentEnd="true"
        style="@style/ActionModeCheckboxStyle"/>
</RelativeLayout>
