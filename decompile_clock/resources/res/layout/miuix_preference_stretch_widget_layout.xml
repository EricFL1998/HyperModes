<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/preferenceItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/top_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:gravity="center"
            android:id="@android:id/icon"
            android:scaleType="center"
            android:layout_centerVertical="true"
            style="@style/Widget.PreferenceIcon"/>
        <TextView
            android:textAppearance="@style/Miuix.AppCompat.TextAppearance.PreferenceList"
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miuix_picker_start_text_top_margin"
            android:layout_marginBottom="@dimen/miuix_picker_start_text_top_margin"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@android:id/icon"/>
        <ImageView
            android:id="@+id/state_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miuix_picker_state_icon_top_margin"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="@dimen/miuix_picker_datetime_text_size"
            android:textColor="@color/miuix_picker_datetime_text_color"
            android:id="@+id/detail_msg_text"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miuix_picker_datetime_top_margin"
            android:text="TextView"
            android:maxLines="2"
            android:textAlignment="viewEnd"
            android:layout_marginEnd="7dp"
            android:layout_toStartOf="@+id/state_image"
            android:layout_toEndOf="@android:id/title"/>
    </RelativeLayout>
    <View
        android:id="@+id/top_line"
        android:background="?attr/colorOutline"
        android:layout_width="match_parent"
        android:layout_height="0.7dp"/>
    <miuix.stretchablewidget.WidgetContainer
        android:orientation="vertical"
        android:id="@android:id/widget_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/button_line"
        android:background="?attr/colorOutline"
        android:layout_width="match_parent"
        android:layout_height="0.7dp"/>
</LinearLayout>
