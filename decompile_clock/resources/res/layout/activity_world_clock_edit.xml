<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/root_view_new"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/place_holder0"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/edit_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/largeMode_actionbar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/world_clock_widget_margin_top"
            android:maxHeight="56dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/button_cancel"
                android:background="@drawable/edit_mode_title_button_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/cancel"
                android:layout_marginStart="20dp"
                style="?attr/actionModeCancelButtonStyle"/>
            <RelativeLayout
                android:gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="@dimen/set_alarm_title_text_size"
                    android:textColor="@color/set_alarm_title_color"
                    android:id="@+id/widget_mode_title"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/world_edit_actionbar_title"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="mipro-medium"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/set_alarm_title_color"
                    android:id="@+id/widget_mode_subtitle"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/widget_mode_title"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="mipro-medium"/>
            </RelativeLayout>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/button_confirm"
                android:background="@drawable/edit_mode_title_button_confirm"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/confirm"
                android:layout_marginEnd="20dp"
                style="?attr/actionModeCancelButtonStyle"/>
        </LinearLayout>
        <miuix.springback.view.SpringBackLayout
            android:id="@+id/spring_back_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scrollOrientation="vertical"
            app:scrollableView="@+id/scroll_view">
            <com.android.deskclock.worldclock.ClockNestedScrollView
                android:id="@+id/scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/root_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include
                        android:id="@+id/search_city_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        layout="@layout/miuix_appcompat_search_stub"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/world_clock_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.android.deskclock.view.list.AlarmRecyclerView
                            android:id="@+id/city_list_show"
                            android:paddingBottom="@dimen/city_list_show_padding_bottom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/tv_world_clock_edit_title_margin_bottom"
                            style="@style/ClockListStyle"/>
                    </LinearLayout>
                </LinearLayout>
            </com.android.deskclock.worldclock.ClockNestedScrollView>
        </miuix.springback.view.SpringBackLayout>
        <ViewStub
            android:id="@+id/city_search_list_show_stub"
            android:layout="@layout/worldclock_city_search_list_show"
            android:inflatedId="@+id/city_search_list_show"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <View
        android:id="@+id/place_holder1"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
</LinearLayout>
