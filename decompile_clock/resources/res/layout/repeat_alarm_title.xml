<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/bottom_sheet_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <ImageView
        android:id="@android:id/button1"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:adjustViewBounds="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/go_back"
        android:layout_marginStart="20dp"
        style="?attr/actionModeCancelButtonStyle"/>
    <TextView
        android:textSize="@dimen/set_alarm_title_text_size"
        android:textColor="@color/set_alarm_title_color"
        android:id="@+id/repeat_title"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_centerVertical="true"
        android:fontFamily="mipro-medium"/>
</RelativeLayout>
