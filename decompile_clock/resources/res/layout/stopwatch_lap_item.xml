<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/lapContainer"
    android:background="@android:color/transparent"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/stopwatch_item_height"
    android:importantForAccessibility="no"
    android:paddingStart="@dimen/stopwatch_lap_item_padding_start"
    android:paddingEnd="@dimen/stopwatch_lap_item_padding_end">
    <TextView
        android:textSize="@dimen/stopwatch_record_size"
        android:textStyle="normal"
        android:textColor="@color/stopwatch_flag_index"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/indexTime"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:importantForAccessibility="yes"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="@dimen/stopwatch_record_size"
        android:textStyle="normal"
        android:textColor="@color/stopwatch_flag_index"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center_vertical"
        android:id="@+id/lapElapsedTime"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        android:importantForAccessibility="yes"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="@dimen/stopwatch_record_size"
        android:textStyle="normal"
        android:textColor="@color/stopwatch_flag_time"
        android:ellipsize="end"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/elapsedTime"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:importantForAccessibility="yes"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
