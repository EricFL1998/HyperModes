<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <miuix.pickerwidget.widget.DateTimePicker
        android:layout_gravity="center"
        android:id="@+id/datetime_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/lunar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/lunar_text"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miuix_picker_switch_vertical_margin"
            android:layout_marginBottom="@dimen/miuix_picker_switch_vertical_margin"
            style="@style/Miuix.AppCompat.TextAppearance.WindowTitle"/>
        <miuix.slidingwidget.widget.SlidingButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/lunar_button"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/miuix_picker_switch_vertical_margin"
            android:layout_marginBottom="@dimen/miuix_picker_switch_vertical_margin"/>
    </FrameLayout>
</LinearLayout>
